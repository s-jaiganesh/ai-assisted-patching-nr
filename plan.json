      "start": "2026-03-18T09:00:00-05:00",
      "end": "2026-03-18T21:00:00-05:00"
    },
    "wave_delay_tolerance_minutes": 15
  },
  "integrations": {
    "aap": {
      "controller_url": "https://ansible.genpt.net",
      "inventory_name": "patching_test",
      "inventory_id": 303,
      "job_template_id": 970,
      "token": "${AAP_TOKEN}",
      "poll_interval_seconds": 15,
      "job_timeout_seconds": 14400,
      "verify_ssl": false,
      "teams_update_every_seconds": 600,
      "remediation_job_template_id": 971
    },
    "postgres": {
      "host": "augpcpdansapp05.genpt.net",
      "port": 5432,
      "dbname": "patching",
      "user": "${PG_USER}",
      "password": "${PG_PASS}"
    },
    "llm": {
      "client_id": "${GAS_CLIENT_ID}",
      "client_secret": "${GAS_CLIENT_SECRET}",
      "token_url": "https://st.api.genpt.com/oauthv2/token",
      "base_url": "https://st.api.genpt.com",
      "model": "gpt-4.1-2025-04-14",
      "llm_proxy_url": "https://st.api.genpt.com/genaisp/gas"
    },
    "newrelic": {
      "enabled": true,
      "graphql_url": "https://api.newrelic.com/graphql",
